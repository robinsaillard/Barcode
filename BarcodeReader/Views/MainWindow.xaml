<Window x:Class="BarcodeReader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BarcodeReader"
        xmlns:vm="clr-namespace:BarcodeReader.ViewModels"
        xmlns:views="clr-namespace:BarcodeReader.Views" 
        xmlns:services="clr-namespace:BarcodeReader.Services"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        MinWidth="800"
        MinHeight="450"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding MainTitle}" 
        Height="450" 
        Width="800"
        TextElement.FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <views:OptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoriqueViewModel}">
            <views:HistoriqueView />
        </DataTemplate>

        <!-- Style du Toggle Button Propre -->
        <Style x:Key="CleanToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Margin="0,0,18,0">
                            <!-- Background arrondi -->
                            <Border x:Name="BackgroundBorder"
                                    Background="#33FFFFFF"
                                    CornerRadius="15"
                                    Padding="12,8"
                                    SnapsToDevicePixels="True"/>

                            <!-- Contenu -->
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Indicateur LED -->
                                <Ellipse x:Name="StatusIndicator"
                                         Width="12"
                                         Height="12"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Margin="8,0,8,0"
                                         Fill="#FF0000"/>

                                <!-- Texte -->
                                <TextBlock x:Name="TextContent"
                                           Grid.Column="1"
                                           Text="Impression auto"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>

                            <!-- Active/Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#3D32CD32"/>
                                <Setter TargetName="StatusIndicator" Property="Fill" Value="#32CD32"/>
                            </Trigger>

                            <!-- Active + Hover -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#5D32CD32"/>
                            </MultiTrigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#8CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <DockPanel Grid.Row="0" Background="#2196f3" LastChildFill="True">

            <!-- Toggle Button Propre -->
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource CleanToggleButtonStyle}"
                          Margin="10,5"
                          Padding="10,0,15,0"
                          Width="149"
                          Height="32"
                          IsChecked="{Binding IsAutoPrintEnabled}" 
                          Grid.IsSharedSizeScope="True"/>

            <!-- MENU -->
            <Menu Background="#2196f3">

                <MenuItem Header="Scan"
                          Command="{Binding NavCommand}"
                          CommandParameter="scan"
                          Foreground="white">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="QrcodeScan"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Options"
                          Command="{Binding NavCommand}"
                          CommandParameter="options"
                          Foreground="white">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="TuneVariant"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Historique"
                          Command="{Binding NavCommand}"
                          CommandParameter="historique"
                          Foreground="white">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="History"/>
                    </MenuItem.Icon>
                </MenuItem>

            </Menu>

        </DockPanel>

        <!-- CONTENU -->
        <Grid Grid.Row="1" x:Name="MainContent">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
